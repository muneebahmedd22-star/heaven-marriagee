{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/api",
      "dest": "backend/server.js"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/proposals",
      "dest": "/proposals.html"
    },
    {
      "src": "/services",
      "dest": "/services.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/support",
      "dest": "/support.html"
    },
    {
      "src": "/reviews-faq",
      "dest": "/reviews-faq.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/data-bank",
      "dest": "/data-bank.html"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/dashboard",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
